generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 解析规则配置
model ParsingRule {
  id              String   @id @default(cuid())
  name            String   // 规则名称（用户定义，如"黎明屯配送单规则"）
  description     String?  // 规则描述
  fileFormat      String   // excel | word | pdf
  fileNamePattern String?  // 文件名匹配模式（可选，用于提示）
  
  structure       Json     
  fieldMappings   Json     
  transformations Json?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  shipments     Shipment[]

  @@map("parsing_rules")
}

// 运单主表
model Shipment {
  id               String    @id @default(cuid())
  externalCode     String?   
  
  storeName        String?
  recipientName    String?
  recipientPhone   String?
  recipientAddress String?
  
  status           String    @default("pending")
  submittedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  parsingRule      ParsingRule? @relation(fields: [parsingRuleId], references: [id])
  parsingRuleId    String?
  
  items            ShipmentItem[]
  
  @@index([externalCode])
  @@index([storeName])
  @@index([recipientName])
  @@index([submittedAt])
  @@map("shipments")
}

// 运单物品明细
model ShipmentItem {
  id            String    @id @default(cuid())
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId    String
  
  skuCode       String
  skuName       String
  quantity      Int
  specification String?
  remarks       String?
  
  isValid       Boolean   @default(true)
  errors        String?   
  
  @@index([shipmentId])
  @@map("shipment_items")
}

// SKU 主数据
model SkuMaster {
  id        String   @id @default(cuid())
  skuCode   String   @unique
  name      String
  spec      String?
  unit      String?
  createdAt DateTime @default(now())

  @@map("sku_master")
}

// 导入任务主表
model ImportTask {
  id              String   @id @default(cuid())
  taskId          String   @unique
  traceId         String
  fileName        String
  fileSize        Int      @default(0)
  storageKey      String?
  status          String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | PARTIAL_SUCCESS | FAILED
  totalRows       Int      @default(0)
  processedRows   Int      @default(0)
  successRows     Int      @default(0)
  failedRows      Int      @default(0)
  totalBatches    Int      @default(0)
  completedBatches Int     @default(0)
  degraded        Boolean  @default(false)
  ruleId          String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  batches         ImportTaskBatch[]
  errors          ImportTaskError[]
  performanceLogs BatchPerformanceLog[]
  traceEvents     TraceEvent[]

  @@index([status, createdAt])
  @@index([taskId])
  @@map("import_tasks")
}

// 处理单元批次状态表
model ImportTaskBatch {
  id            String   @id @default(cuid())
  taskId        String
  unitId        String
  batchIndex    Int
  startRow      Int
  endRow        Int
  status        String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  retryCount    Int      @default(0)
  lockedAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())

  task          ImportTask @relation(fields: [taskId], references: [taskId])
  errors        ImportTaskError[]
  performanceLog BatchPerformanceLog?

  @@unique([taskId, unitId])
  @@index([taskId])
  @@map("import_task_batches")
}

// 行级错误明细
model ImportTaskError {
  id           String   @id @default(cuid())
  taskId       String
  unitId       String
  batchIndex   Int
  rowNumber    Int
  fieldName    String
  rawValue     String?
  errorCode    String
  errorReason  String
  traceId      String
  createdAt    DateTime @default(now())

  task         ImportTask @relation(fields: [taskId], references: [taskId])
  batch        ImportTaskBatch @relation(fields: [taskId, unitId], references: [taskId, unitId])

  @@index([taskId, unitId])
  @@index([errorCode])
  @@map("import_task_errors")
}

// 本地可靠事件表 (Outbox)
model EventOutbox {
  id            String   @id @default(cuid())
  aggregateId   String   // task_id
  eventType     String   // ImportBatchCreated, etc.
  payload       Json
  status        String   @default("PENDING") // PENDING | SENT | FAILED
  retryCount    Int      @default(0)
  nextRetryAt   DateTime?
  createdAt     DateTime @default(now())
  sentAt        DateTime?

  @@index([status, nextRetryAt])
  @@index([aggregateId])
  @@map("event_outbox")
}

// 处理单元性能日志
model BatchPerformanceLog {
  id                 String   @id @default(cuid())
  taskId             String
  unitId             String
  batchIndex         Int
  parseDurationMs    Int      @default(0)
  ruleDurationMs     Int      @default(0)
  validateDurationMs Int      @default(0)
  insertDurationMs   Int      @default(0)
  totalDurationMs    Int      @default(0)
  status             String
  traceId            String
  createdAt          DateTime @default(now())

  task               ImportTask @relation(fields: [taskId], references: [taskId])
  batch              ImportTaskBatch @relation(fields: [taskId, unitId], references: [taskId, unitId])

  @@unique([taskId, unitId])
  @@index([taskId, unitId])
  @@map("batch_performance_log")
}

// 链路时间线事件
model TraceEvent {
  id          String   @id @default(cuid())
  traceId     String
  taskId      String?
  unitId      String?
  eventName   String
  eventStatus String
  message     String?
  occurredAt  DateTime @default(now())

  task        ImportTask? @relation(fields: [taskId], references: [taskId])

  @@index([traceId, occurredAt])
  @@map("trace_events")
}
